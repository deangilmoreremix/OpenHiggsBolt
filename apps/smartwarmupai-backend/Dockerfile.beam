# syntax=docker/dockerfile:1.7
# SmartWarmupAI backend for Beam: the all-in-one pod (Postgres + Redis + NATS + API) plus the mail worker and the event consumer.
# Build context is this folder with the upstream sources in ./src (apps/warmbly-server of remix-new-editor, commit in src/UPSTREAM.md;
# see README.md). Deploy: see README.md. Everything is CGO-free, as upstream builds it.

FROM golang:1.26-bookworm AS builder
ARG VERSION="" COMMIT="" BUILT_AT=""
WORKDIR /app
COPY src/go.mod src/go.sum ./
RUN --mount=type=cache,id=gomod,target=/go/pkg/mod go mod download
COPY src/ .
RUN --mount=type=cache,id=gomod,target=/go/pkg/mod --mount=type=cache,id=gobuild,target=/root/.cache/go-build \
    set -eux; \
    LD="-s -w -X github.com/warmbly/warmbly/internal/version.Version=$VERSION -X github.com/warmbly/warmbly/internal/version.Commit=$COMMIT -X github.com/warmbly/warmbly/internal/version.BuiltAt=$BUILT_AT"; \
    for c in backend migrate warmblyctl worker consumer; do \
      CGO_ENABLED=0 go build -ldflags="$LD" -o /out/$c ./cmd/$c; \
    done

FROM nats:2.15.3 AS nats

FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg less locales tini redis-server xz-utils zstd libnss-wrapper \
 && install -d /usr/local/share/keyrings \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/local/share/keyrings/postgres.gpg.asc \
 && echo "deb [signed-by=/usr/local/share/keyrings/postgres.gpg.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main 16" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-16 postgresql-common \
 && rm -rf /var/lib/apt/lists/*
COPY --from=nats /nats-server /usr/local/bin/nats-server
COPY --from=builder /out/ /app/bin/
COPY src/ /app/src/
COPY env.sh entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh
ENTRYPOINT ["tini", "--", "/app/entrypoint.sh"]
