{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "@/api/*": [
        "./src/shared/api/*"
      ],
      "@/api": [
        "./src/shared/api"
      ],
      "@/types/*": [
        "./src/shared/types/*"
      ],
      "@/types": [
        "./src/shared/types"
      ],
      "@/stores/*": [
        "./src/stores/*"
      ],
      "@/stores": [
        "./src/stores"
      ],
      "@/components/*": [
        "./components/*",
        "./src/shared/components/*"
      ],
      "@/components": [
        "./components",
        "./src/shared/components"
      ],
      "ai-agent": [
        "./packages/Open-Poe-AI/packages/agents/src/index.js"
      ],
      "workflow-builder": [
        "./packages/Vibe-Workflow/packages/workflow-builder/src/index.js"
      ],
      "design-agent": [
        "./packages/Open-AI-Design-Agent/packages/design-agent/src/index.js"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
