# Server-side only. Never expose in the browser.
FIRECRAWL_API_KEY=

# Optional override for the OpenAI model used in asset classification.
# Defaults to gpt-4o-mini if unset.
OPENAI_ASSET_CLASSIFICATION_MODEL=

# Enable Firecrawl as optional last-resort fallback for asset discovery.
# Defaults to false. Set to true only if you want Firecrawl to run when
# local providers (static, browser) fail to meet quality thresholds.
ENABLE_FIRECRAWL_FALLBACK=false

# Enable browser-based asset discovery fallback (requires Playwright/Chromium).
# Defaults to false. Not recommended for Netlify serverless functions.
ENABLE_BROWSER_DISCOVERY=false

# ── Apps Studio reseller commerce ───────────────────────────────────────────
# Existing Stripe keys are read for session creation; the reseller price IDs
# below are REQUIRED for the $197 DIY / $597 Training / $400 upgrade flows.
# While any of them is missing, /api/reseller/checkout and
# /api/reseller/upgrade return 503 RESELLER_STRIPE_NOT_CONFIGURED listing the
# missing names (no purchase is ever simulated). Create the three products +
# prices in the Stripe dashboard, then set them here. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
RESELLER_STRIPE_PRICE_DIY=
RESELLER_STRIPE_PRICE_TRAINING=
RESELLER_STRIPE_PRICE_UPGRADE=

# Private bucket for entitled source-bundle delivery (signed, short-lived
# URLs only). Optional: defaults to "reseller-app-bundles".
RESELLER_BUNDLES_BUCKET=
