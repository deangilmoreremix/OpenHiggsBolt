{
  "name": "open-generative-ai",
  "description": "Open-source alternative to HF AI — AI image, video, cinema and lip sync studio",
  "homepage": "https://github.com/Anil-matcha/Open-Generative-AI",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "workspaces": [
    "packages/studio",
    "packages/Vibe-Workflow/packages/workflow-builder",
    "packages/Open-Poe-AI/packages/agents",
    "apps/cutai/frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev-prod.js",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:vfx": "vitest run tests/vfx-service.vitest.test.js tests/vfx-validation.vitest.test.js",
    "test:muapi": "tsx --test tests/muapiKeyCrypto.test.js tests/muapi-key-route.test.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "demo:capture": "playwright test --config=playwright.marketing.config.ts --project=marketing-demos",
    "demo:auth": "playwright test --config=playwright.marketing.config.ts --project=\"global setup\"",
    "verify:muapi": "node scripts/verify-muapi-apis.mjs",
    "validate:env": "node scripts/validate-env.js",
    "prestart": "node scripts/validate-env.js",
    "start": "next start",
    "lint": "next lint",
    "cutai:frontend": "npm run dev -w @openhiggsbolt/cutai",
    "cutai:backend": "cd apps/cutai/backend && source venv/bin/activate && uvicorn main:app --reload --port 8000",
    "cutai:dev": "concurrently \"npm run cutai:backend\" \"npm run cutai:frontend\"",
    "build:workflow": "npm run build -w workflow-builder",
    "build:agent": "npm run build -w ai-agent",
    "build:studio": "npm run build -w studio",
    "build:packages": "npm run build:workflow && npm run build:agent && npm run build:studio",
    "setup": "git submodule update --init --recursive && npm install && npm run build:packages",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "npm run vite:build && electron .",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:linux:dir": "vite build && electron-builder --linux dir",
    "electron:build:linux:arm64:dir": "vite build && electron-builder --linux dir --arm64",
    "stage:local-ai": "node scripts/stage-local-ai-binary.js",
    "package:linux:deb": "node scripts/package-linux-deb.js",
    "package:linux:deb:arm64": "node scripts/package-linux-deb.js --arch arm64",
    "package:linux:deb:x64": "node scripts/package-linux-deb.js --arch x64",
    "electron:build:all": "vite build && electron-builder --mac --win --linux",
    "render:validate": "render blueprints validate",
    "render:deploy": "render blueprints apply --confirm",
    "source:status": "node scripts/verify-source-of-truth.mjs",
    "source:verify": "node scripts/verify-source-of-truth.mjs",
    "build:metadata": "node scripts/generate-build-info.mjs",
    "prebuild": "node scripts/verify-html-encoding-sniffer-patch.mjs && node scripts/build-fast-discovery.mjs && node scripts/build-motion-capture.mjs",
    "build:fast-discovery": "node scripts/build-fast-discovery.mjs",
    "build:motion-capture": "node scripts/build-motion-capture.mjs",
    "gen:demo-texts": "node scripts/gen-demo-texts.mjs"
  },
  "build": {
    "appId": "ai.generative.open",
    "productName": "SmartVideo GO",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/local-ai",
        "to": "local-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "public/banner.png",
      "category": "Utility",
      "maintainer": "SmartVideo GO Team",
      "extraFiles": [
        {
          "from": "build/linux/apparmor.profile",
          "to": "resources/apparmor.profile"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@clerk/backend": "3.23.0",
    "@clerk/nextjs": "^7.5.13",
    "@crawlee/cheerio": "^3.18.1",
    "@crawlee/core": "^3.18.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@octokit/rest": "^22.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/media": "4.0.499",
    "@remotion/motion-blur": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/web-renderer": "4.0.499",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "ai-agent": "file:./packages/Open-Poe-AI/packages/agents",
    "autoprefixer": "^10.4.24",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0-rc.12",
    "chromium-bidi": "^10.5.1",
    "crawlee": "^3.18.1",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "jsdom": "^29.1.1",
    "lenis": "1.3.26",
    "lucide-react": "^1.21.0",
    "motion": "^11.18.0",
    "octokit": "^5.0.5",
    "openai": "^6.44.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.0",
    "remotion": "4.0.499",
    "stripe": "^22.6.1",
    "studio": "*",
    "svix": "^1.96.1",
    "swiper": "14.3.0",
    "tailwindcss": "^3.4.0",
    "three": "0.186.1",
    "workflow-builder": "file:./packages/Vibe-Workflow/packages/workflow-builder",
    "zustand": "5.0.8",
    "zod": "4.3.6",
    "@remotion/zod-types": "4.0.499"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.6",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-jsx": "2.2.9",
    "@types/three": "0.186.0",
    "concurrently": "^10.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "next": "15.5.15",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.js",
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-konva": "19.2.4"
  },
  "pnpm": {
    "overrides": {
      "react-konva": "19.2.4"
    }
  }
}
